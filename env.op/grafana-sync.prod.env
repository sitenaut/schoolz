# The optional extras grafana_sync.py reads, kept out of grafana.prod.env so the
# read-only query tools never load them. References only, no values. Use both files:
#   bash scripts/prod-secrets.sh run --reason "..." \
#     --secrets GRAFANA_URL,GRAFANA_TOKEN,GRAFANA_GA_PROPERTY_ID,GRAFANA_GA_SERVICE_ACCOUNT_FILE,ANTHROPIC_ADMIN_API_KEY,GRAFANA_CLOUDWATCH_ACCESS_KEY_ID,GRAFANA_CLOUDWATCH_SECRET_ACCESS_KEY \
#     -- op run --env-file env.op/grafana.prod.env --env-file env.op/grafana-sync.prod.env \
#     -- python3 scripts/grafana_sync.py --dry-run
# Every line must point at an item that exists, or op run fails.
# Google Analytics panels. The service-account key is a document item
# (GRAFANA_GA_SERVICE_ACCOUNT_FILE), read by grafana_sync.py:ensure_ga.
GRAFANA_GA_PROPERTY_ID=op://schoolz-prod/GRAFANA_GA_PROPERTY_ID/credential
# Workspace and key names on the Cost dashboard; without it they show as ids.
ANTHROPIC_ADMIN_API_KEY=op://schoolz-prod/ANTHROPIC_ADMIN_API_KEY/credential
# The CloudWatch datasource behind the Alexa-skill alerts.
GRAFANA_CLOUDWATCH_ACCESS_KEY_ID=op://schoolz-prod/GRAFANA_CLOUDWATCH_ACCESS_KEY_ID/credential
GRAFANA_CLOUDWATCH_SECRET_ACCESS_KEY=op://schoolz-prod/GRAFANA_CLOUDWATCH_SECRET_ACCESS_KEY/credential
