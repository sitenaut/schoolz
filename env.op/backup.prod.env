# Backup secrets as 1Password references - no values here, safe to commit.
# Used under scripts/prod-secrets.sh for a restore drill or a by-hand backup;
# see docs/BACKUPS.md. The nightly workflow reads the same values from the
# GitHub prod environment instead.
BACKUP_DATABASE_URL=op://schoolz-prod/DATABASE_URL/credential
BACKUP_S3_ENDPOINT=op://schoolz-prod/BACKUP_S3_ENDPOINT/credential
BACKUP_S3_ACCESS_KEY=op://schoolz-prod/BACKUP_S3_ACCESS_KEY/credential
BACKUP_S3_SECRET_KEY=op://schoolz-prod/BACKUP_S3_SECRET_KEY/credential
BACKUP_AGE_IDENTITY=op://schoolz-prod/BACKUP_AGE_IDENTITY/credential
