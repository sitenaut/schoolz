# Template for the vars scripts/alembic_env.sh prod and CI need for prod migrations.
# Real values live only in env/secrets.prod.env (gitignored, never committed) or in
# GitHub Actions secrets that materialize that file at CI runtime. See docs/ENV_SETUP.md.

APP_ENV=prod
AUTH_MODE=supabase

DATABASE_URL=
DATABASE_SSL_MODE=require

SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
BOOTSTRAP_ADMIN_EMAIL=
