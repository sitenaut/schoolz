// Grafana Alloy — receive OTLP from backend/scheduler, forward metrics to
// Mimir. Local-only counterpart of the OTLP push wired in backend/telemetry.py
// (see docs/OBSERVABILITY_PLAN.md Phase 2g). backend/scheduler set
// OTEL_TRACES_EXPORTER=none and OTEL_LOGS_EXPORTER=none locally - Promtail
// still ships local logs from stdout, so only metrics flow through here.

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.exporter.prometheus.mimir.input]
  }
}

otelcol.exporter.prometheus "mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:8080/api/v1/push"
  }
}
