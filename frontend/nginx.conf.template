# Dynamic rendering for SEO: the frontend is a client-rendered SPA, so a
# crawler that doesn't execute JS (and even one that does, on a
# budget/delayed pass) sees an empty `<div id="root">` instead of real
# content. Known crawler user agents get proxied to the backend's
# /prerender endpoint (backend/services/prerender.py), which renders the
# SAME route through the scraper's headless Chromium and returns the
# resulting HTML - everyone else still gets the normal SPA. This is the
# standard "dynamic rendering" pattern search engines have long documented
# support for, not cloaking (bots and humans see the same content, just
# rendered at a different time).
map $http_user_agent $is_crawler {
    default 0;
    "~*googlebot|bingbot|yandex|duckduckbot|baiduspider|applebot|facebookexternalhit|twitterbot|linkedinbot|slackbot|discordbot|telegrambot|whatsapp|pinterest|redditbot|gptbot|chatgpt-user|oai-searchbot|ccbot|perplexitybot|claudebot|anthropic-ai|bytespider|semrushbot|ahrefsbot|mj12bot" 1;
}

server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Send RELATIVE redirects ("Location: /focus/"), so the browser resolves
    # them against the origin it actually used. With nginx's default
    # absolute_redirect, a directory redirect is built from this server's own
    # listen port - 3000 - which is never the port the client reached us on:
    # local compose publishes 5173->3000, and in prod fly-proxy terminates
    # TLS on 443 and forwards plain HTTP here. So "GET /focus" (no trailing
    # slash) answered "Location: http://localhost:3000/focus/" locally, and
    # would have sent prod visitors to http://schoolz.sitenaut.com:3000/ -
    # wrong scheme and wrong port. Same class of bug as schoolz-api needing
    # --proxy-headers to stop emitting http:// Location headers.
    #
    # Only reachable now that a real subdirectory exists: every path in the
    # SPA above falls through try_files to /index.html and never redirects.
    absolute_redirect off;

    # A proxy_pass target that's fully static text (after envsubst) isn't
    # allowed to carry a URI part ("/prerender") inside an `if` block -
    # nginx: "proxy_pass cannot have URI part ... inside 'if' statement".
    # Keeping a variable in the target ($uri, for the prerender path)
    # sidesteps that restriction by making it a dynamic proxy_pass - which
    # in turn needs an explicit resolver, since nginx can't pre-resolve a
    # variable target at config load. Docker Engine's embedded DNS
    # (127.0.0.11) answers this locally; Fly's system resolver (which also
    # resolves ordinary public hostnames, not just .internal ones -
    # confirmed by every other outbound call this app already makes)
    # answers it in prod (see Dockerfile/fly.toml for RESOLVER).
    resolver ${RESOLVER} valid=30s;

    # nginx:alpine's stock mime.types has no entry for .webmanifest, so it
    # was served as application/octet-stream.
    types {
        application/manifest+json webmanifest;
    }
    include /etc/nginx/mime.types;

    # Same-origin proxy for Grafana Faro (RUM). *.grafana.net collector
    # hosts are on common ad-block lists - proxying through our own domain
    # keeps RUM data from silently disappearing for those visitors. The
    # collector URL is public by design (it ships in the JS bundle either
    # way), so baking it into the built image via envsubst is fine - this
    # is templated (not a plain .conf) specifically so FARO_COLLECTOR_URL
    # can be a runtime Fly secret instead of a build arg.
    location = /rum/collect {
        proxy_pass ${FARO_COLLECTOR_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        client_max_body_size 1m;
    }

    # Static assets are served directly regardless of user agent - a
    # crawler bounced to /prerender never needs its own JS/CSS anyway
    # (it gets fully-rendered HTML instead), and this keeps the
    # bot-detection block below from ever intercepting a hashed asset
    # request.
    location ~* \.(?:js|css|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|map|json|xml|txt|webmanifest)$ {
        try_files $uri =404;
    }

    # The Focus app (frontend-focus/) is a separate Vite build served from
    # the SAME ORIGIN as this one, which is the entire mechanism behind its
    # shared session: localStorage is scoped to the origin, not the path,
    # so a token written by a login here is already readable there with
    # nothing passed between them. A subdomain would not share it.
    #
    # Placed before `location /` so the crawler branch below never grabs
    # it: everything under /focus/ is behind auth, so there's nothing for
    # a bot to index, and a prerender pass would spend one of the
    # scraper's three concurrency slots rendering a login wall.
    location /focus/ {
        try_files $uri $uri/ /focus/index.html;
    }

    location / {
        # proxy_ssl_server_name isn't valid inside an `if` block (nginx:
        # "directive is not allowed here"), so it sits here instead -
        # harmless for the non-crawler case below, which never reaches
        # proxy_pass at all.
        #
        # BACKEND_INTERNAL_URL is schoolz-api's PUBLIC hostname in prod
        # (not its .internal 6PN address): schoolz-api only has a public
        # http_service, and fly-proxy's own health check needs it bound to
        # 0.0.0.0, which doesn't accept 6PN's IPv6-only private-network
        # traffic (learned the hard way - switching schoolz-api to an
        # IPv6 bind to serve 6PN broke fly-proxy outright, a real prod
        # outage on 2026-09-12). Routing through the public hostname
        # instead means schoolz-api never needs to accept private-network
        # traffic for this feature at all.
        proxy_ssl_server_name on;

        if ($is_crawler) {
            proxy_pass ${BACKEND_INTERNAL_URL}/prerender?path=$uri;
            break;
        }
        try_files $uri $uri/ /index.html;
    }
}
