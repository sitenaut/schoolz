# Grafana Cloud API access, for read-only diagnosis and grafana_sync.py. References only, no values:
#   bash scripts/prod-secrets.sh run --reason "..." --secrets GRAFANA_URL,GRAFANA_TOKEN \
#     -- op run --env-file env.op/grafana.prod.env -- python3 scripts/grafana_query.py 'prom:up'
# A sync also needs env.op/grafana-sync.prod.env (the full command is at its top);
# with this file alone it skips GA, the Cost dashboard's names and CloudWatch.
GRAFANA_URL=op://schoolz-prod/GRAFANA_URL/credential
GRAFANA_TOKEN=op://schoolz-prod/GRAFANA_TOKEN/credential
