{
  "uid": "schoolz-ux",
  "title": "schoolz / User experience",
  "description": "Did anyone come, where from, did they convert, and did the site work for them.",
  "tags": [
    "schoolz"
  ],
  "timezone": "America/New_York",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Metrics",
        "multi": false,
        "name": "DS_METRICS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Logs (Faro RUM)",
        "multi": false,
        "name": "DS_LOGS",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "schoolz database",
        "multi": false,
        "name": "DS_SQL",
        "options": [],
        "query": "grafana-postgresql-datasource",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Google Analytics",
        "multi": false,
        "name": "DS_GA",
        "options": [],
        "query": "yesoreyeram-infinity-datasource",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Visits by page (server-side, last 30d)",
      "description": "The reliable number: counted server-side, so ad blockers don't hide it. Aggregate only - one row per day/page/source, nothing per visitor.",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SQL}"
          },
          "rawSql": "SELECT day AS \"Day\", path AS \"Page\", sum(count) AS \"Visits\"\nFROM page_visits\nWHERE day >= to_char(now() - interval '30 days', 'YYYY-MM-DD')\nGROUP BY 1, 2 ORDER BY 1 DESC, 3 DESC;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Where visitors came from (last 30d)",
      "description": "'facebook' is the campaign cohort. First-touch per browser session, so a reader who lands from Facebook and clicks through stays attributed to Facebook.",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SQL}"
          },
          "rawSql": "SELECT source AS \"Source\", sum(count) AS \"Visits\"\nFROM page_visits\nWHERE day >= to_char(now() - interval '30 days', 'YYYY-MM-DD')\nGROUP BY 1 ORDER BY 2 DESC;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Survey funnel (last 30d)",
      "description": "The question the Facebook post is actually asking: how many read it, how many opened the survey, how many finished.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SQL}"
          },
          "rawSql": "SELECT\n  (SELECT COALESCE(sum(count), 0) FROM page_visits\n     WHERE path = '/chcomms' AND day >= to_char(now() - interval '30 days', 'YYYY-MM-DD')) AS \"Read /chcomms\",\n  (SELECT COALESCE(sum(count), 0) FROM page_visits\n     WHERE path = '/survey' AND day >= to_char(now() - interval '30 days', 'YYYY-MM-DD')) AS \"Opened /survey\",\n  (SELECT count(*) FROM survey_responses\n     WHERE created_at > now() - interval '30 days') AS \"Completed survey\";",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Newsletters submitted by the community (last 30d)",
      "description": "The single most valuable conversion - a submitted Smore link is what makes a school's page fill in.",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SQL}"
          },
          "rawSql": "SELECT date_trunc('day', created_at) AS time, count(*) AS \"Submissions\"\nFROM community_submissions\nWHERE created_at > now() - interval '30 days'\nGROUP BY 1 ORDER BY 1;",
          "rawQuery": true,
          "format": "time_series",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Survey satisfaction distribution",
      "description": "",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SQL}"
          },
          "rawSql": "SELECT satisfaction AS \"Score (1-5)\", count(*) AS \"Responses\"\nFROM survey_responses WHERE satisfaction IS NOT NULL\nGROUP BY 1 ORDER BY 1;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "What parents say is hard to find",
      "description": "Directly answers whether the report's priorities match what parents actually feel. A topic nobody picks is one we guessed wrong about.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_SQL}"
          },
          "rawSql": "SELECT jsonb_array_elements_text(pain_points::jsonb) AS \"Topic\", count(*) AS \"Picked by\"\nFROM survey_responses\nWHERE jsonb_typeof(pain_points::jsonb) = 'array'\nGROUP BY 1 ORDER BY 2 DESC;",
          "rawQuery": true,
          "format": "table",
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Page views by route (RUM)",
      "description": "RUM's view of the same traffic as panel 1. Lower than the server-side count by roughly the ad-blocker rate - the gap between the two is itself informative.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum by (route) (count_over_time({app_name=\"schoolz-faro\"} | logfmt | kind=\"event\" | event_name=\"page_view\" [1h]))",
          "queryType": "range",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "CTA clicks on /chcomms (RUM)",
      "description": "Which of the three asks actually converts: send_newsletter, take_survey, or try_app.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum by (cta) (count_over_time({app_name=\"schoolz-faro\"} | logfmt | kind=\"event\" | event_name=\"cta_click\" [6h]))",
          "queryType": "range",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Core Web Vitals p75 by route",
      "description": "Largest Contentful Paint, the vital Google actually ranks on.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "quantile_over_time(0.75, {app_name=\"schoolz-faro\"} | logfmt | kind=\"measurement\" | unwrap lcp [1h]) by (route)",
          "queryType": "range",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "JavaScript errors by route (RUM)",
      "description": "Catches the class of bug that blanked every local build (faro-react's FaroRoutes) before a user has to report it.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOGS}"
          },
          "expr": "sum by (route) (count_over_time({app_name=\"schoolz-faro\"} | logfmt | kind=\"exception\" [1h]))",
          "queryType": "range",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Visitors and page views per day (Google Analytics)",
      "description": "GA's count, which loads only on the production hostname and never for crawlers or admins flagged internal. Compare with the server-side page-visit panels: the gap is ad blockers plus anyone who left before GA's deferred load.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_GA}"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "timeseries",
          "parser": "backend",
          "url": "https://analyticsdata.googleapis.com/v1beta/properties/${GA_PROPERTY}:runReport",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"dateRanges\": [{\"startDate\": \"${__from:date:YYYY-MM-DD}\", \"endDate\": \"${__to:date:YYYY-MM-DD}\"}], \"dimensions\": [{\"name\": \"date\"}], \"metrics\": [{\"name\": \"activeUsers\"}, {\"name\": \"screenPageViews\"}], \"orderBys\": [{\"dimension\": {\"dimensionName\": \"date\"}}]}"
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "dimensionValues.0.value",
              "text": "day",
              "type": "timestamp",
              "timestampFormat": "20060102"
            },
            {
              "selector": "metricValues.0.value",
              "text": "visitors",
              "type": "number"
            },
            {
              "selector": "metricValues.1.value",
              "text": "page views",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "title": "Where sessions come from (Google Analytics)",
      "description": "The one question only GA can answer here: search, social, direct or a campaign link.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_GA}"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://analyticsdata.googleapis.com/v1beta/properties/${GA_PROPERTY}:runReport",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"dateRanges\": [{\"startDate\": \"${__from:date:YYYY-MM-DD}\", \"endDate\": \"${__to:date:YYYY-MM-DD}\"}], \"dimensions\": [{\"name\": \"sessionDefaultChannelGroup\"}], \"metrics\": [{\"name\": \"sessions\"}], \"orderBys\": [{\"metric\": {\"metricName\": \"sessions\"}, \"desc\": true}], \"limit\": 10}"
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "dimensionValues.0.value",
              "text": "channel",
              "type": "string"
            },
            {
              "selector": "metricValues.0.value",
              "text": "sessions",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Top pages (Google Analytics)",
      "description": "Paths as GA receives them: tokens stripped, personal and admin routes collapsed.",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 39
      },
      "targets": [
        {
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_GA}"
          },
          "refId": "A",
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "backend",
          "url": "https://analyticsdata.googleapis.com/v1beta/properties/${GA_PROPERTY}:runReport",
          "url_options": {
            "method": "POST",
            "body_type": "raw",
            "body_content_type": "application/json",
            "data": "{\"dateRanges\": [{\"startDate\": \"${__from:date:YYYY-MM-DD}\", \"endDate\": \"${__to:date:YYYY-MM-DD}\"}], \"dimensions\": [{\"name\": \"pagePath\"}], \"metrics\": [{\"name\": \"screenPageViews\"}, {\"name\": \"activeUsers\"}], \"orderBys\": [{\"metric\": {\"metricName\": \"screenPageViews\"}, \"desc\": true}], \"limit\": 15}"
          },
          "root_selector": "rows",
          "columns": [
            {
              "selector": "dimensionValues.0.value",
              "text": "page",
              "type": "string"
            },
            {
              "selector": "metricValues.0.value",
              "text": "views",
              "type": "number"
            },
            {
              "selector": "metricValues.1.value",
              "text": "visitors",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ],
  "editable": true
}
