# Copy to .env for `docker compose` runs that don't go through scripts/compose-local.sh
# (that script sources env/*.local.env instead — see docs/ENV_SETUP.md).
# This file is tracked; never put real secrets in it.

APP_ENV=local
AUTH_MODE=local

DATABASE_NAME=schoolz
DATABASE_USER=schoolz
POSTGRES_PASSWORD=change-me-locally

# Only used when AUTH_MODE=local
JWT_SECRET=change-me-to-a-long-random-local-only-secret

# Optional: seeds a default admin user on backend startup (idempotent).
# Leave any of the three unset to skip seeding.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Only used when AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_PUBLISHABLE_KEY=

PUBLIC_WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000
