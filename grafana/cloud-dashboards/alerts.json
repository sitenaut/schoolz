{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "schoolz-alerts",
      "folder": "schoolz",
      "interval": "5m",
      "rules": [
        {
          "uid": "schoolz-scheduler-down",
          "title": "schoolz: scheduler has stopped reconciling",
          "condition": "C",
          "for": "10m",
          "labels": {
            "app": "schoolz",
            "severity": "warning"
          },
          "annotations": {
            "summary": "The scheduler process hasn't ticked in 10 minutes - every scan is silently stopped. It reconciles every 30s, so this should never be below 1."
          },
          "noDataState": "Alerting",
          "execErrState": "Error",
          "orgId": 1,
          "folderUID": "schoolz",
          "ruleGroup": "schoolz-alerts",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "${DS_METRICS}",
              "model": {
                "refId": "A",
                "expr": "sum(increase(schoolz_scheduler_reconciles_total{service_namespace=\"schoolz\"}[10m]))",
                "instant": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "reducer": "last",
                "expression": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "schoolz-job-error-ratio",
          "title": "schoolz: scan failure ratio above 30%",
          "condition": "C",
          "for": "30m",
          "labels": {
            "app": "schoolz",
            "severity": "warning"
          },
          "annotations": {
            "summary": "More than 30% of scans failed over the last 12h window (one full scan cycle). Check the Scans dashboard's failures-by-error-code panel."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "orgId": 1,
          "folderUID": "schoolz",
          "ruleGroup": "schoolz-alerts",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "${DS_METRICS}",
              "model": {
                "refId": "A",
                "expr": "sum(increase(schoolz_job_runs_total{service_namespace=\"schoolz\", status=\"error\"}[12h])) / clamp_min(sum(increase(schoolz_job_runs_total{service_namespace=\"schoolz\"}[12h])), 1)",
                "instant": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "reducer": "last",
                "expression": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.3
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "schoolz-api-5xx",
          "title": "schoolz: API 5xx ratio above 2%",
          "condition": "C",
          "for": "10m",
          "labels": {
            "app": "schoolz",
            "severity": "warning"
          },
          "annotations": {
            "summary": "The API is returning server errors to real visitors."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "orgId": 1,
          "folderUID": "schoolz",
          "ruleGroup": "schoolz-alerts",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "${DS_METRICS}",
              "model": {
                "refId": "A",
                "expr": "sum(rate(http_server_request_duration_seconds_count{service_namespace=\"schoolz\", http_response_status_code=~\"5..\"}[10m])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{service_namespace=\"schoolz\"}[10m])), 0.001)",
                "instant": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "reducer": "last",
                "expression": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.02
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "schoolz-api-latency",
          "title": "schoolz: public GET p95 above 1.5s",
          "condition": "C",
          "for": "15m",
          "labels": {
            "app": "schoolz",
            "severity": "warning"
          },
          "annotations": {
            "summary": "The site feels slow. Check whether it's cold starts or a specific route on the API dashboard."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "orgId": 1,
          "folderUID": "schoolz",
          "ruleGroup": "schoolz-alerts",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "${DS_METRICS}",
              "model": {
                "refId": "A",
                "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_namespace=\"schoolz\"}[10m])))",
                "instant": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "reducer": "last",
                "expression": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        1.5
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "schoolz-llm-truncated",
          "title": "schoolz: an LLM reply was truncated (max_tokens)",
          "condition": "C",
          "for": "5m",
          "labels": {
            "app": "schoolz",
            "severity": "warning"
          },
          "annotations": {
            "summary": "An extraction hit the output cap and was cut off mid-structure. This has silently produced zero extracted items from a full newsletter before - the run won't necessarily look failed."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "orgId": 1,
          "folderUID": "schoolz",
          "ruleGroup": "schoolz-alerts",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "${DS_METRICS}",
              "model": {
                "refId": "A",
                "expr": "sum(increase(schoolz_llm_calls_total{service_namespace=\"schoolz\", stop_reason=\"max_tokens\"}[1h]))",
                "instant": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "reducer": "last",
                "expression": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "schoolz-scraper-failing",
          "title": "schoolz: scraper failing more than 30% of page loads",
          "condition": "C",
          "for": "30m",
          "labels": {
            "app": "schoolz",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Most scraper fetches are failing - either the scraper machine is unhealthy or a lot of school sites are unreachable. Scans will be returning warnings rather than data."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "orgId": 1,
          "folderUID": "schoolz",
          "ruleGroup": "schoolz-alerts",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "${DS_METRICS}",
              "model": {
                "refId": "A",
                "expr": "sum(rate(schoolz_scraper_page_load_seconds_count{service_name=\"schoolz-scraper\", outcome=\"error\"}[1h])) / clamp_min(sum(rate(schoolz_scraper_page_load_seconds_count{service_name=\"schoolz-scraper\"}[1h])), 0.001)",
                "instant": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "reducer": "last",
                "expression": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.3
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "schoolz-parse-issues",
          "title": "schoolz: parse issues spiking",
          "condition": "C",
          "for": "1h",
          "labels": {
            "app": "schoolz",
            "severity": "warning"
          },
          "annotations": {
            "summary": "Scans are succeeding but dropping an unusual amount of content. This is the failure mode that doesn't turn anything red - coverage degrades quietly."
          },
          "noDataState": "OK",
          "execErrState": "Error",
          "orgId": 1,
          "folderUID": "schoolz",
          "ruleGroup": "schoolz-alerts",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 3600,
                "to": 0
              },
              "datasourceUid": "${DS_METRICS}",
              "model": {
                "refId": "A",
                "expr": "sum(increase(schoolz_parse_issues_total{service_namespace=\"schoolz\"}[6h]))",
                "instant": true,
                "editorMode": "code"
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "B",
                "type": "reduce",
                "reducer": "last",
                "expression": "A"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "B",
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        50
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
