# Local secrets as 1Password references - no values here, safe to commit.
# scripts/compose-local.sh runs compose under `op run --env-file` with this
# file, so the values exist only in that process's environment, never on disk.
# Add a secret: create an API Credential item titled NAME in the schoolz-local
# vault (or re-run scripts/op-import-env.py), then add a line here.
POSTGRES_PASSWORD=op://schoolz-local/POSTGRES_PASSWORD/credential
JWT_SECRET=op://schoolz-local/JWT_SECRET/credential
GRAFANA_PASSWORD=op://schoolz-local/GRAFANA_PASSWORD/credential
ADMIN_EMAIL=op://schoolz-local/ADMIN_EMAIL/credential
ADMIN_USERNAME=op://schoolz-local/ADMIN_USERNAME/credential
ADMIN_PASSWORD=op://schoolz-local/ADMIN_PASSWORD/credential
SCRAPER_API_KEY=op://schoolz-local/SCRAPER_API_KEY/credential
LOCAL_EVENTS_SCRAPER_KEY=op://schoolz-local/LOCAL_EVENTS_SCRAPER_KEY/credential
GOOGLE_CLIENT_ID=op://schoolz-local/GOOGLE_CLIENT_ID/credential
GOOGLE_CLIENT_SECRET=op://schoolz-local/GOOGLE_CLIENT_SECRET/credential
ANTHROPIC_API_KEY=op://schoolz-local/ANTHROPIC_API_KEY/credential
ANTHROPIC_API_KEY_ONBOARDING=op://schoolz-local/ANTHROPIC_API_KEY_ONBOARDING/credential
CHATBOT_GEMINI_API_KEY=op://schoolz-local/CHATBOT_GEMINI_API_KEY/credential
